---
import Archive from "@/components/Archive"
import Layout from "@/layouts/Layout.astro"
import { langOf, strings } from "@/lib/i18n"
import { issuesIn } from "@/lib/issues"

// Also the English site's archive (en/archive/), in the language of the URL.
const lang = langOf(Astro.currentLocale)
const t = strings[lang]
// Only what a row shows goes into the page, not every issue's full text. A fallback issue has no
// description, nor does an English one not written yet; its first headline stands in.
const entries = issuesIn(lang).map((issue) => ({
  date: issue.date,
  fallback: issue.fallback,
  description: issue.description || (issue.sections[0]?.items[0]?.title ?? ""),
  items: issue.sections.reduce((n, section) => n + section.items.length, 0),
}))
---

<Layout title={`${t.nav.archive} · ${t.siteTitle}`} description={t.archive.description(t.siteTitle)} current="archive">
  <Archive client:load entries={entries} lang={lang} />
</Layout>
