---
import ProcessPage from "@/components/ProcessPage.astro"
import { issues } from "@/lib/issues"
import { type Process, processes } from "@/lib/process"

// How the issue was made (生成过程), for each issue that has its record.
export function getStaticPaths() {
  return processes
    .filter((process) => issues.some((i) => i.date === process.date))
    .map((process) => ({ params: { date: process.date }, props: { process } }))
}

interface Props {
  process: Process
}
---

<ProcessPage process={Astro.props.process} />
