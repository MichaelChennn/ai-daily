---
import IssuePage from "@/components/IssuePage.astro"
import { type Issue, issues } from "@/lib/issues"

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { date: issue.date }, props: { issue } }))
}

interface Props {
  issue: Issue
}
---

<IssuePage issue={Astro.props.issue} />
