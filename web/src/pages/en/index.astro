---
import IssuePage from "@/components/IssuePage.astro"
import PressLayout from "@/layouts/PressLayout.astro"
import { strings } from "@/lib/i18n"
import { enIssues } from "@/lib/issues"

// The English site's home page: the newest issue, the same page as at en/<date>/.
const [latest] = enIssues
const t = strings.en
---

{
  latest ? (
    <IssuePage issue={latest} home />
  ) : (
    <PressLayout title={t.siteTitle} description={`${t.siteTitle}.`}>
      <main><p class="notice">{t.empty}</p></main>
    </PressLayout>
  )
}
