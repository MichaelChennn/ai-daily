---
import IssuePage from "@/components/IssuePage.astro"
import { enIssues, type Issue } from "@/lib/issues"

export function getStaticPaths() {
  return enIssues.map((issue) => ({ params: { date: issue.date }, props: { issue } }))
}

interface Props {
  issue: Issue
}
---

<IssuePage issue={Astro.props.issue} />
