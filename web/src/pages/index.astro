---
import IssuePage from "@/components/IssuePage.astro"
import PressLayout from "@/layouts/PressLayout.astro"
import { strings } from "@/lib/i18n"
import { issues, SITE_TITLE } from "@/lib/issues"

// The newest issue, the same page as at its date.
const [latest] = issues
---

{
  latest ? (
    <IssuePage issue={latest} home />
  ) : (
    <PressLayout title={SITE_TITLE} description={`${SITE_TITLE}。`}>
      <main><p class="notice">{strings.zh.empty}</p></main>
    </PressLayout>
  )
}
