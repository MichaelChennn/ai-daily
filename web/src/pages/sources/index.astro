---
import Sources from "@/components/Sources"
import Layout from "@/layouts/Layout.astro"
import { langOf, strings } from "@/lib/i18n"
import sourcesEn from "../../../data/en/sources.json"
import sourcesZh from "../../../data/sources.json"

// Also the English site's sources page (en/sources/), in the language of the URL.
const lang = langOf(Astro.currentLocale)
const t = strings[lang]
---

<Layout title={`${t.nav.sources} · ${t.siteTitle}`} description={t.sources.description(t.siteTitle)} wide current="sources">
  <Sources client:load data={lang === "en" ? sourcesEn : sourcesZh} lang={lang} />
</Layout>
