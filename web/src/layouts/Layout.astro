---
import "@/styles/global.css"
import SiteFooter from "@/components/SiteFooter.astro"
import SiteHeader, { type NavPage } from "@/components/SiteHeader.astro"
import { href, issues, SITE_TITLE } from "@/lib/issues"

interface Props {
  title: string
  description: string
  /** The header's width instead of the issue column, for a grid of cards. */
  wide?: boolean
  /** The header link for this page. */
  current?: NavPage
  /** This page's canonical path, if not its own; null for none (the 404 page). */
  canonical?: string | null
  /** An issue page's editing credit for the footer: "由 Claude 编辑". */
  editor?: string
  /** The header's Beta link, on an issue that has betas. */
  beta?: string
}

const {
  title,
  description,
  wide = false,
  current,
  canonical = Astro.url.pathname,
  editor,
  beta,
} = Astro.props
// The home page shows the newest issue: going between it and an issue slides by date, as if it
// were at that issue's date (the script below).
const home = href("")
const latest = issues[0]?.date ?? ""
---

<!doctype html>
<html lang="zh-CN" data-home={home} data-latest={latest}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Opt into cross-document view transitions here, not in the stylesheet: when the new page
         is revealed its stylesheet may still be loading (not cached yet), and Chrome then skips
         the transition. Hold the first paint until the content is parsed, so the transition
         animates the whole issue rather than its first part. -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    <link rel="expect" href="#content-end" blocking="render" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical !== null && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={href("feed.xml")} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Set the theme before the first paint (shadcn's Astro dark mode setup): the saved
      // choice, else the system preference.
      ;(() => {
        let saved = null
        try {
          saved = localStorage.getItem("theme")
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches
        document.documentElement.classList.toggle("dark", dark)
      })()
      // A publisher logo that fails to load leaves its monogram showing. Error events do not
      // bubble, so listen in the capture phase; this runs before any <img> exists.
      document.addEventListener(
        "error",
        (event) => {
          const target = event.target
          if (target instanceof HTMLImageElement && target.dataset.logo !== undefined) target.remove()
        },
        true,
      )
      // Going to a newer issue slides it in from the right, an older one from the left (the
      // animations are in global.css); the home page counts as the newest issue, so between the
      // two it only cross-fades. Registered here so it runs before the new page's first paint.
      addEventListener("pagereveal", (event) => {
        const transition = event.viewTransition
        const root = document.documentElement
        const day = (url) => {
          if (!url) return undefined
          const path = new URL(url, location.href).pathname
          return path.match(/\d{4}-\d{2}-\d{2}/)?.[0] ?? (path === root.dataset.home ? root.dataset.latest : undefined)
        }
        const from = day(document.referrer)
        const to = day(location.href)
        if (!transition || !from || !to || from === to) return
        root.dataset.slide = to > from ? "newer" : "older"
        transition.finished.finally(() => delete root.dataset.slide)
      })
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <SiteHeader current={current} beta={beta} />
    <main class:list={["mx-auto w-full flex-1 px-4 sm:px-6", wide ? "max-w-5xl" : "max-w-3xl"]}>
      <slot />
      <div id="content-end" hidden></div>
    </main>
    <SiteFooter editor={editor} />
    <script>
      import "@/scripts/source-overflow"
    </script>
  </body>
</html>
