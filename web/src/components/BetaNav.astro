---
import { FlaskConical } from "lucide-react"

import { Button } from "@/components/ui/button"
import { betaHref, type Issue, issueHref } from "@/lib/issues"

interface Props {
  issue: Issue
}

// The way between the main issue and its betas (the API route's editions). The main issue gets
// one capsule into the betas; a beta page names its model and switches between the betas.
const { issue } = Astro.props
const [first] = issue.betas
---

{
  !issue.beta && first && (
    <div class="-mt-4 mb-6 flex justify-center">
      <Button asChild variant="outline" size="sm" className="rounded-full">
        <a href={betaHref(issue.date, first.slug)}>
          <FlaskConical aria-hidden="true" />
          Beta · API 编辑版
        </a>
      </Button>
    </div>
  )
}
{
  issue.beta && (
    <div class="-mt-4 mb-6 flex flex-col items-center gap-3">
      <nav aria-label="切换 Beta 版本" class="flex flex-wrap justify-center gap-1">
        <Button asChild variant="ghost" size="sm" className="rounded-full text-muted-foreground">
          <a href={issueHref(issue.date)}>主版</a>
        </Button>
        {issue.betas.map((beta) =>
          beta.slug === issue.beta!.slug ? (
            <Button asChild size="sm" className="rounded-full">
              <span aria-current="page">{beta.label}</span>
            </Button>
          ) : (
            <Button asChild variant="outline" size="sm" className="rounded-full">
              <a href={betaHref(issue.date, beta.slug)}>{beta.label}</a>
            </Button>
          ),
        )}
      </nav>
      <p class="text-xs text-muted-foreground">Beta · 由 {issue.editor} 编辑，和主版分开校验与展示</p>
    </div>
  )
}
