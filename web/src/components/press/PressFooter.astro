---
import { langOf, strings } from "@/lib/i18n"
import { betaHref, href, type Issue, issueHref, pageHref, pagePath, REPO_URL } from "@/lib/issues"
import { editionLogo, modelName } from "@/lib/models"
import { processes, processHref } from "@/lib/process"

interface Props {
  /** The issue on this page; without one (the archive, the sources) the line has the update time only. */
  issue?: Issue
  /** On a page without an issue, what the line says instead of the update time (the sources' "stats over 30 issues"). */
  note?: string
  /** As wide as a page's main.wide (the sources' three columns). */
  wide?: boolean
  /** On the issue's 生成过程 page: no editor credit, and the toolbar's 生成过程 is the current page. */
  process?: boolean
}

// One line: who edited this issue and when the site updates at the left, the GitHub, RSS and
// license icons at the right. How the issue was made and its other editions are hidden features,
// in the toolbar behind the ⓘ button in the bottom-right corner. The language switch sits above
// the theme toggle in the bottom-left corner.
const { issue, note, wide, process: onProcess = false } = Astro.props
const lang = langOf(Astro.currentLocale)
const t = strings[lang]
const p = t.press
const process = !!issue && lang === "zh" && processes.some((x) => x.date === issue.date) ? processHref(issue.date) : null
// Every edition of the issue, the main one first, each by its maker's logo; none if it has no beta.
const editions =
  !issue || issue.betas.length === 0
    ? []
    : [
        { slug: "main", label: p.main, href: issueHref(issue.date), current: !issue.beta && !onProcess },
        ...issue.betas.map((b) => ({ slug: b.slug, label: p.edition(b.label), href: betaHref(issue.date, b.slug), current: b.slug === issue.beta?.slug })),
      ].map((e) => ({ ...e, initial: (e.slug === "main" ? "Claude" : e.label).charAt(0), logo: editionLogo(e.slug) }))
// This page in the other language; the English site has no beta pages, nor yet a 生成过程 page
// (#63), so there it is the main issue.
const other = lang === "zh" ? "en" : "zh"
const otherHref = pageHref(pagePath(Astro.url.pathname, lang).replace(/(beta\/.*|process\/)$/, ""), other)
const icon = { width: 16, height: 16, viewBox: "0 0 24 24", "aria-hidden": "true" as const }
---

<footer class:list={{ wide }}>
  <p class="about">
    {
      issue && !onProcess ? (
        <>
          <span class="nw">{t.credit(modelName(issue.editor), issue.fallback)} ·</span> <span class="nw">{t.schedule}</span>
        </>
      ) : (
        <span class="nw">{note ?? t.schedule}</span>
      )
    }
  </p>
  <span class="ext">
    <a href={REPO_URL} aria-label={t.github} title={t.github}><svg {...icon} fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path></svg></a>
    <a href={href(t.feed)} aria-label={t.rss} title={t.rss}><svg {...icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg></a>
    <!-- Creative Commons: two c's in a circle; the license's name is in the label and the tooltip -->
    <a href={t.licenseUrl} rel="license" aria-label={t.license} title={t.license}><svg {...icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><path d="M10.5 9.8a3 3 0 1 0 0 4.4"></path><path d="M17 9.8a3 3 0 1 0 0 4.4"></path></svg></a>
  </span>
</footer>

{
  (process || editions.length > 0) && (
    <>
      <button class="info" id="info" aria-label={p.info} title={p.info} aria-expanded="false" aria-controls="tools">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
      </button>
      <div class="tools" id="tools" role="toolbar" aria-label={p.info}>
        {
          process && (
            <a href={process} aria-label={p.process} data-label={p.process} aria-current={onProcess ? "page" : undefined}>
              <svg {...icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg>
            </a>
          )
        }
        {process && editions.length > 0 && <span class="sep"></span>}
        {
          editions.map((e) => (
            <a href={e.href} aria-label={e.label} data-label={e.label} aria-current={e.current ? "page" : undefined}>
              <span class="logo16">{e.initial}{e.logo && <img data-logo src={e.logo} alt="" referrerpolicy="no-referrer" />}</span>
            </a>
          ))
        }
      </div>
    </>
  )
}

<!-- 文 and A from the Languages icon; the page's own language sits top left and is drawn last,
     so it passes over the other one when the page arrives from the other language. -->
<a class="lang" id="lang" href={otherHref} hreflang={other} data-lang={other} aria-label={p.languages} title={p.languages}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {lang === "zh" ? <><g class="g-a"><path class="ko" d="m22 22-5-10-5 10M14 18h6"></path><path d="m22 22-5-10-5 10M14 18h6"></path></g><g class="g-wen"><path class="ko" d="m5 8 6 6m-7 0 6-6 2-3M2 5h12M7 2h1"></path><path d="m5 8 6 6m-7 0 6-6 2-3M2 5h12M7 2h1"></path></g></>
      : <><g class="g-wen"><path class="ko" d="m5 8 6 6m-7 0 6-6 2-3M2 5h12M7 2h1"></path><path d="m5 8 6 6m-7 0 6-6 2-3M2 5h12M7 2h1"></path></g><g class="g-a"><path class="ko" d="m22 22-5-10-5 10M14 18h6"></path><path d="m22 22-5-10-5 10M14 18h6"></path></g></>}
  </svg>
</a>

<button class="theme" id="theme" aria-label={p.theme}><svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg><svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></button>
