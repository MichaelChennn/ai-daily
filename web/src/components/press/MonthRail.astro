---
import { type Lang, strings } from "@/lib/i18n"
import { pageHref } from "@/lib/issues"
import RailIcons from "./RailIcons.astro"

interface Props {
  /** The months with an issue, as YYYY-MM, oldest first. */
  months: string[]
  lang: Lang
}

// The archive's timeline: the issue pages' rail with one tick per month instead of per day, the
// newest at the bottom. A tick scrolls to its month (the page script lights the month in view).
// Above it, the arrow back to the issues; the script points it at the issue the reader came from.
const { months, lang } = Astro.props
const t = strings[lang].press
const W = Math.min(20, months.length)
const label = (m: string) => t.month(Number(m.slice(0, 4)), Number(m.slice(5, 7)))
---

<nav class="rail back" id="rail" aria-label={t.months} style={`--W:${W}`}>
  <a class="ret" id="ret" href={pageHref("", lang)} aria-label={t.back}>
    <svg width="18" height="18" viewBox="0 0 19 20" fill="none"><path d="M9.11 .89v16.89" stroke-width="3" stroke-miterlimit="10"></path><path d="M1.06 9.83l8.05 8.05 8.04-8.05" stroke-width="3" stroke-miterlimit="10"></path></svg>
    <span class="il">{t.back}</span>
  </a>
  <div class="ticks" id="ticks">
    <div class="ticks-inner" id="ticksInner">
      {
        months.map((m) => (
          <a class="tick" href={`#m-${m}`} data-m={m} aria-label={label(m)}>
            <div class="fill"></div>
            <div class="label"><span class="t">{label(m)}</span></div>
          </a>
        ))
      }
    </div>
  </div>
  <RailIcons lang={lang} current="archive" />
</nav>
<div class="bubble" id="bubble" hidden></div>
