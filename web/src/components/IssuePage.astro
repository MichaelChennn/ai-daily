---
import ItemCard from "@/components/press/ItemCard.astro"
import ItemMeta from "@/components/press/ItemMeta.astro"
import PressFooter from "@/components/press/PressFooter.astro"
import Rail from "@/components/press/Rail.astro"
import Wordmark from "@/components/press/Wordmark.astro"
import PressLayout from "@/layouts/PressLayout.astro"
import { langOf, strings } from "@/lib/i18n"
import { betaName, type Issue, issueHref } from "@/lib/issues"
import controls from "@/scripts/controls.js?raw"
import script from "@/scripts/press.js?raw"

interface Props {
  issue: Issue
  /** The home page shows the newest issue too; its canonical URL is the issue's own. */
  home?: boolean
}

// One issue, at YYYY-MM-DD/ and (the newest) at the home page, or one of its betas at
// YYYY-MM-DD/beta/<slug>/ (the timeline still goes between main issues). Sections start right
// away: no issue number, date or summary above them.
const { issue, home = false } = Astro.props
const lang = langOf(Astro.currentLocale)
const t = strings[lang]
const title =
  `${issue.date} · ` +
  (issue.beta ? `Beta · ${betaName(issue.date, issue.beta)} · ` : "") +
  t.siteTitle +
  (issue.fallback ? t.fallbackTitle : "")
const description = issue.description || t.description(issue.date)
---

<PressLayout title={title} description={description} canonical={home ? issueHref(issue.date, lang) : undefined}>
  <Wordmark lang={lang} />
  <Rail date={issue.date} lang={lang} />

  <main id="main">
    <h1 class="sr-only">{title}</h1>
    {issue.notice && <p class="notice drop">{issue.notice}</p>}
    {
      issue.sections.map((section, k) => {
        const full = section.items.filter((item) => !item.compact)
        const briefs = section.items.filter((item) => item.compact)
        return (
          <section data-sec={section.id} id={section.id}>
            <div class="sec-h drop">
              <span class="n">{String(k + 1).padStart(2, "0")}</span>
              <h2>{section.label}</h2>
            </div>
            <div class="stack">
              {full.map((item, i) => (
                <ItemCard item={item} lang={lang} index={i} />
              ))}
            </div>
            {briefs.length > 0 && (
              <ul class="briefs">
                {briefs.map((item) => (
                  <li class="drop">
                    <span class="bt"><a href={item.sources[0].url} target="_blank" rel="noopener">{item.title}</a></span>
                    <ItemMeta item={item} lang={lang} compact />
                    {item.summary && (
                      <div class="bs"><div><p class="summary">{item.summary}</p></div></div>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      })
    }
  </main>
  <PressFooter issue={issue} />

  <script is:inline set:html={controls} />
  <script is:inline set:html={script} />
</PressLayout>
