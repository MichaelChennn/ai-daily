---
import { Rss } from "lucide-react"
import { langOf, strings } from "@/lib/i18n"
import { href } from "@/lib/issues"

interface Props {
  /** On an issue page, who edited it: "本期由 Claude 编辑". */
  editor?: string
}

const { editor } = Astro.props
const lang = langOf(Astro.currentLocale)
const t = strings[lang]
---

<footer class="mt-20 border-t">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="flex flex-col gap-1">
      <span class="font-semibold tracking-tight">{t.siteTitle}</span>
      <span class="text-xs text-muted-foreground">
        {editor && <>{editor} · </>}{t.schedule}
      </span>
    </div>
    <a
      href={href(t.feed)}
      class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground"
    >
      <Rss className="size-4" aria-hidden="true" />
      {t.rss}
    </a>
  </div>
</footer>
