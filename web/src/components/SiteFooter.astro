---
import { Rss } from "lucide-react"
import { href, SITE_TITLE } from "@/lib/issues"
---

<footer class="mt-20 border-t">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="flex flex-col gap-1">
      <span class="font-semibold tracking-tight">{SITE_TITLE}</span>
      <span class="text-xs text-muted-foreground">每天柏林时间 06:00 更新 · 编辑由 Claude 完成</span>
    </div>
    <a
      href={href("feed.xml")}
      class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground"
    >
      <Rss className="size-4" aria-hidden="true" />
      RSS Feed
    </a>
  </div>
</footer>
