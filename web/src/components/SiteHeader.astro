---
import { cn } from "cn"
import { FlaskConical } from "lucide-react"

import { buttonVariants } from "@/components/ui/button"
import LanguageMenu from "@/components/LanguageMenu"
import ThemeToggle from "@/components/ThemeToggle"
import { langOf, strings } from "@/lib/i18n"
import { pageHref, pagePath, REPO_URL } from "@/lib/issues"

export type NavPage = "today" | "archive" | "sources" | "beta"

interface Props {
  /** Which link is the current page, marked with a pill. */
  current?: NavPage
  /** Where the Beta link at the far right goes; no link without one. */
  beta?: string
}

// Links styled with buttonVariants, not <Button asChild>: Slot cannot merge into children passed
// from .astro. cn() so that `hidden` overrides the variant's inline-flex.
// The pill and each label have their own view-transition-name, so going to another page the pill
// glides from one link to the other (z-order in global.css) while the labels stay put.
const { current, beta } = Astro.props
// This page in the other language: the English site mirrors the Chinese one under en/, and has
// no betas, so a beta page's English counterpart is its main issue.
const lang = langOf(Astro.currentLocale)
const home = pageHref("", lang)
const page = pagePath(Astro.url.pathname, lang)
const zhHref = pageHref(page)
const enHref = pageHref(page.replace(/beta\/.*$/, ""), "en")
const t = strings[lang]
const nav: { page: NavPage; label: string; href: string; wide?: boolean }[] = [
  { page: "today", label: t.nav.today, href: home, wide: true },
  { page: "archive", label: t.nav.archive, href: pageHref("archive/", lang) },
  { page: "sources", label: t.nav.sources, href: pageHref("sources/", lang) },
]
---

<header
  data-site-header
  class="sticky top-0 z-40 [view-transition-name:site-header] border-b border-transparent transition-[border-color] duration-200 data-scrolled:border-border bg-background/90 backdrop-blur supports-backdrop-filter:bg-background/75">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="text-[15px] font-semibold tracking-tight whitespace-nowrap">{t.siteTitle}</a>
    <div class="flex items-center gap-1">
      <nav class="flex items-center gap-0.5">
        {
          nav.map((link) => (
            <a
              href={link.href}
              aria-current={link.page === current ? "page" : undefined}
              class={cn(
                buttonVariants({ variant: "ghost", size: "sm" }),
                "relative isolate rounded-full px-3 font-normal text-muted-foreground hover:bg-transparent hover:text-foreground aria-[current=page]:text-foreground",
                link.wide && "hidden sm:inline-flex",
              )}
            >
              {link.page === current && (
                <span class="absolute inset-0 -z-10 [view-transition-name:nav-pill] rounded-full bg-foreground/8 dark:bg-muted" />
              )}
              <span style={{ viewTransitionName: `nav-${link.page}` }}>{link.label}</span>
            </a>
          ))
        }
      </nav>
      <LanguageMenu client:load lang={lang} label={t.language} zh={zhHref} en={enHref} />
      <ThemeToggle client:load label={t.theme} />
      <a
        href={REPO_URL}
        aria-label={t.github}
        class={cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "hidden sm:inline-flex")}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"
          ></path>
        </svg>
      </a>
      {/* The Beta icon has a slot of its own at the far right, kept empty on issues without
          betas, so the icons beside it stay put from page to page. */}
      {
        beta ? (
          <a
            href={beta}
            aria-label={current === "beta" ? t.backToMain : t.beta}
            title={current === "beta" ? t.backToMain : t.beta}
            aria-current={current === "beta" ? "page" : undefined}
            class={cn(
              buttonVariants({ variant: "ghost", size: "icon-sm" }),
              "relative isolate rounded-full hover:bg-transparent",
            )}
          >
            {current === "beta" && (
              <span class="absolute inset-0 -z-10 [view-transition-name:nav-pill] rounded-full bg-foreground/8 dark:bg-muted" />
            )}
            <FlaskConical className="[view-transition-name:nav-beta]" />
          </a>
        ) : (
          <span aria-hidden="true" class="size-8 shrink-0" />
        )
      }
    </div>
  </div>
</header>

<script>
  // The divider under the header shows only once the page has scrolled, so at the top the header
  // and the page read as one surface.
  const header = document.querySelector<HTMLElement>("[data-site-header]")
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", scrollY > 0)
    update()
    addEventListener("scroll", update, { passive: true })
  }
</script>
